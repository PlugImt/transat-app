{
  "expo": {
    "name": "Transat",
    "slug": "Transat",
    "owner": "plugimt",
    "version": "2.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon-bg.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/transat.icon",
      "bundleIdentifier": "com.yohann69.transat2-0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "Allow you to add an event to your personal calendar."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "backgroundColor": "#EC7F32"
      },
      "package": "com.yohann69.transat2_0",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-bg.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-bg.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/notification_sound.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to update your profile picture."
        }
      ],
      "expo-calendar",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-bg.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0505"
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Use SENTRY_AUTH_TOKEN env to authenticate with Sentry.",
          "project": "transat-app",
          "organization": "plugimt"
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "04d25877-7d89-4041-8e48-209ceee3a640"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}